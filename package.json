{
  "name": "verbapix",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Cards, Grammar, Fun",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "serve-https": "vite --https",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.{js,vue}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "audit:content": "node scripts/audit-content.cjs",
    "audit:i18n": "node scripts/audit-i18n.cjs",
    "audit:all": "npm run audit:content && npm run audit:i18n",
    "test": "npm run test:unit && npm run audit:all",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "core-js": "^3.37.1",
    "html2canvas": "^1.4.1",
    "laravel-echo": "^2.2.6",
    "pusher-js": "^8.4.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.0",
    "vue-router": "^4.3.0",
    "vue3-touch-events": "^4.0.0",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.1.0",
    "whatwg-fetch": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/preset-env": "^7.24.5",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.4.21",
    "@vue/test-utils": "^2.4.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.4.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.57.0",
    "sass": "^1.74.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "uuid": "^9.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
